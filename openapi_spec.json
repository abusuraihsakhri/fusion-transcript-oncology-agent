{
  "openapi": "3.1.0",
  "info": {
    "title": "Fusion Transcript Oncology Agent Demonstration API",
    "description": "Deterministic software rule demonstration using synthetic data only. No clinical validation or genomic fusion calling.",
    "version": "3.0.1",
    "contact": {
      "name": "Dr. Abu Suraih Sakhri",
      "url": "https://github.com/abusuraihsakhri"
    }
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Health and metadata check",
        "responses": {
          "200": {
            "description": "System optimal"
          }
        }
      }
    },
    "/metrics": {
      "get": {
        "summary": "Return current in-memory demonstration counters",
        "responses": {
          "200": {
            "description": "JSON counters"
          },
          "401": {
            "description": "Invalid or missing API access token"
          },
          "503": {
            "description": "API_ACCESS_TOKEN not configured"
          }
        },
        "security": [
          {
            "ApiKeyAuth": []
          }
        ]
      }
    },
    "/api/audit": {
      "post": {
        "summary": "Dispatch task payload across specialized workers",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "task_id": {
                    "type": "string"
                  },
                  "target_identifier": {
                    "type": "string"
                  },
                  "primary_metric": {
                    "type": "number"
                  },
                  "secondary_metric": {
                    "type": "number"
                  },
                  "status_descriptor": {
                    "type": "string"
                  },
                  "is_critical_flag": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "task_id",
                  "target_identifier",
                  "primary_metric"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Deterministic demonstration dossier with in-process HMAC chain reference"
          },
          "401": {
            "description": "Invalid or missing API access token"
          },
          "422": {
            "description": "Invalid input or possible personal identifier"
          },
          "503": {
            "description": "API_ACCESS_TOKEN not configured"
          }
        },
        "security": [
          {
            "ApiKeyAuth": []
          }
        ]
      }
    },
    "/api/chat": {
      "post": {
        "summary": "Return deterministic mock response",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "query": {
                    "type": "string"
                  }
                },
                "required": [
                  "query"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Supervisory response"
          },
          "401": {
            "description": "Invalid or missing API access token"
          },
          "422": {
            "description": "Possible personal identifier"
          },
          "503": {
            "description": "API_ACCESS_TOKEN not configured"
          }
        },
        "security": [
          {
            "ApiKeyAuth": []
          }
        ]
      }
    },
    "/api/audit/logs": {
      "get": {
        "summary": "Return in-memory audit chain and HMAC verification result",
        "responses": {
          "200": {
            "description": "Cryptographic audit trail"
          },
          "401": {
            "description": "Invalid or missing API access token"
          },
          "503": {
            "description": "API_ACCESS_TOKEN not configured"
          }
        },
        "security": [
          {
            "ApiKeyAuth": []
          }
        ]
      }
    }
  },
  "components": {
    "securitySchemes": {
      "ApiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-Key"
      }
    }
  }
}
